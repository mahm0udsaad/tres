# Public Supabase project settings (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Server-only keys
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Existing owner bootstrap console
ADMIN_PIN=CHANGE_ME
ADMIN_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Operations subdomain. When set, the operations system (/staff + the owner
# operations console /admin/operations) is served ONLY on this host, and those
# routes redirect to it from the main domain. Leave BLANK for local dev and
# previews — everything is then served in place on one host.
# Add this exact host as a domain on the same Vercel project and point DNS to it.
NEXT_PUBLIC_OPS_HOST=ops.tres.com.sa
